\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u094b\u0921 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948.',t29:'\u0915\u0943\u092a\u092f\u093e \u0936\u093e\u0916\u093e\u090f\u0901 \u091a\u0941\u0928\u0947\u0902',t30:'\u0915\u0943\u092a\u092f\u093e \u0921\u0940\u0932\u0930/\u0906\u0930\u090f\u0938\u090f\u0938\u0921\u0940/\u0909\u092a-\u0921\u0940\u0932\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964',t31:'\u0915\u0943\u092a\u092f\u093e \u0909\u0924\u094d\u092a\u093e\u0926 \u091a\u0941\u0928\u0947\u0902.',t32:'\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0924\u094d\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902.',t33:'\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092e\u093e\u0924\u094d\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902.',t34:'\u0926\u093f\u0928\u093e\u0902\u0915\u0938\u092e\u092f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948.',t35:'\u0915\u0943\u092a\u092f\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902.',t36:'\u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964',t37:'\u0915\u0943\u092a\u092f\u093e \u0915\u094b\u0908 \u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926 \u091a\u0941\u0928\u0947\u0902.',t38:'\u0915\u0943\u092a\u092f\u093e \u0906\u0930\u0902\u092d \u0924\u093f\u0925\u093f \u0914\u0930 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f \u091a\u0941\u0928\u0947\u0902',t39:'\u0915\u0943\u092a\u092f\u093e \u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902.',t40:'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902.',t41:'\u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0920\u0947\u0915\u0947\u0926\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964',t42:'\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u091b\u0935\u093f \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',t43:'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',t44:'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0935\u0948\u0927 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',t45:'\u0915\u0943\u092a\u092f\u093e \u0920\u0947\u0915\u0947\u0926\u093e\u0930 \u0915\u0947 \u092a\u0924\u093f \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',t46:'\u0915\u0943\u092a\u092f\u093e \u0920\u0947\u0915\u0947\u0926\u093e\u0930 \u0915\u0947 \u092a\u0924\u093f \u0915\u0940 \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',t47:'\u0908\u092e\u0947\u0932 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964',t48:'\u0935\u0948\u0927 \u0908\u092e\u0947\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948.',t49:'\u092e\u0924\u0926\u093e\u0924\u093e \u091c\u0930\u0942\u0930\u0940 \u0939\u0948.',t50:'\u092e\u0924\u0926\u093e\u0924\u093e \u0928\u0902\u092c\u0930 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f.',t51:'\u0915\u0943\u092a\u092f\u093e \u092e\u0924\u0926\u093e\u0924\u093e \u0915\u093e\u0930\u094d\u0921 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902.',t52:'\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u091c\u093e\u0902\u091a\u0947\u0902\u0964',t53:'\u0915\u0943\u092a\u092f\u093e \u092e\u0924\u0926\u093e\u0924\u093e \u0915\u093e\u0930\u094d\u0921 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964',t54:'\u0915\u0943\u092a\u092f\u093e \u0915\u094b\u0908 \u092d\u0940 \u0906\u0908\u0921\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964'};case'Assamese':return{error:'\u0986\u0981\u09b8\u09cb\u09f1\u09be\u09b9',success:'\u09b8\u09ab\u09b2\u09a4\u09be',exit_app:'\u098f\u09aa\u09f0 \u09aa\u09f0\u09be \u0993\u09b2\u09be\u0987 \u09af\u09be\u0993\u0995',t1:'\u098f\u0987 \u098f\u09aa\u099f\u09cb\u09f1\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0995\u09c7\u09ae\u09c7\u09f0\u09be\u09a4 \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6 \u0995\u09f0\u09bf\u09ac \u09ac\u09bf\u099a\u09be\u09f0\u09bf\u09ac',t2:'\u098f\u0995\u09be\u0989\u09a3\u09cd\u099f \u09ae\u099a\u09bf \u09aa\u09c7\u09b2\u09be\u0993\u0995',t3:'\u0986\u09aa\u09c1\u09a8\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u09ad\u09be\u09f1\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u099f\u09cb \u09ae\u099a\u09bf \u09aa\u09c7\u09b2\u09be\u09ac\u09a8\u09c7?',t4:'\u0985\u099c\u09cd\u099e\u09be\u09a4 \u09ad\u09c1\u09b2 \u09b9\u09c8\u099b\u09c7\u0964',t5:'\u0986\u09aa\u09c1\u09a8\u09bf \u098f\u0987 \u098f\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u099a\u09a8\u09f0 \u09aa\u09f0\u09be \u0993\u09b2\u09be\u0987 \u0986\u09b9\u09bf\u09ac \u09ac\u09bf\u099a\u09be\u09f0\u09c7\u09a8\u09c7?',t6:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09a6\u09bf\u09af\u09bc\u0995 \u09f7',t7:'\u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b8\u09cd\u0995\u09f0\u09a3 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7',t8:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf Google Play Store \u09f0 \u09aa\u09f0\u09be \u09b6\u09c7\u09b9\u09a4\u09c0\u09af\u09bc\u09be \u09ac\u09bf\u09b2\u09cd\u09a1\u099f\u09cb \u0987\u09a8\u09b7\u09cd\u099f\u09b2 \u0995\u09f0\u0995',t9:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf App Store \u09f0 \u09aa\u09f0\u09be \u09b6\u09c7\u09b9\u09a4\u09c0\u09af\u09bc\u09be \u09ac\u09bf\u09b2\u09cd\u09a1\u099f\u09cb \u0987\u09a8\u09b7\u09cd\u099f\u09b2 \u0995\u09f0\u0995',t10:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0985\u2019\u099f\u09bf\u09aa\u09bf \u09b2\u09bf\u0996\u0995\u0964',t11:'\u0985\u2019\u099f\u09bf\u09aa\u09bf \u09ea \u09b8\u0982\u0996\u09cd\u09af\u09be \u09b9\u2019\u09ac \u09b2\u09be\u0997\u09c7\u0964',t12:'\u09a8\u09be\u09ae \u09a6\u09f0\u0995\u09be\u09f0\u0964',t13:'\u09ab\u09cb\u09a8 \u09a8\u0982\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t14:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09b8\u09be\u09ae\u0997\u09cd\u09f0\u09c0\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t15:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09b6\u09be\u0996\u09be \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t16:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09a1\u09bf\u09b2\u09be\u09f0/RSSD \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t17:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09ac\u09bf\u09a1\u09bf\u0987 \u09ac\u09be\u099b\u09a8\u09bf \u0995\u09f0\u0995\u0964',t18:'\u09a0\u09bf\u0995\u09a8\u09be \u09e7 \u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t19:'\u099a\u09b9\u09f0\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t20:'\u099c\u09bf\u09b2\u09be\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t21:'\u09f0\u09be\u099c\u09cd\u09af\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8',t22:'\u09a6\u09c7\u09b6\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t23:'\u09aa\u09bf\u09a8 \u0995\u2019\u09a1\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t24:'\u099c\u09a8\u09cd\u09ae \u09a4\u09be\u09f0\u09bf\u0996\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t25:'\u0986\u09a7\u09be\u09f0\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t26:'\u0986\u09a7\u09be\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09e7\u09e8 \u0985\u0982\u0995 \u09b9\u09ac \u09b2\u09be\u0997\u09c7\u0964',t27:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09a7\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1 \u09ac\u09cd\u09f0\u09be\u0989\u099c \u0995\u09f0\u0995\u0964',t28:"\u0995\u09f0\u09cd\u09ae\u099a\u09be\u09f0\u09c0\u09f0 \u0995'\u09a1 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc\u0964",t29:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09b6\u09be\u0996\u09be \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995',t30:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09a1\u09bf\u09b2\u09be\u09f0/rssd/\u099a\u09be\u09ac-\u09a1\u09bf\u09b2\u09be\u09f0 \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t31:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09aa\u09cd\u09f0\u09a1\u09be\u0995\u09cd\u099f \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t32:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09aa\u09f0\u09bf\u09ae\u09be\u09a3 \u09b2\u09bf\u0996\u0995\u0964',t33:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09ac\u09c8\u09a7 \u09aa\u09f0\u09bf\u09ae\u09be\u09a3 \u09a6\u09bf\u09af\u09bc\u0995\u0964',t34:'\u09a4\u09be\u09f0\u09bf\u0996\u09b8\u09ae\u09af\u09bc\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t35:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09ac\u09be\u09f0\u09cd\u09a4\u09be \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6 \u0995\u09f0\u0995\u0964',t36:'\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a1\u09bf\u09ad\u09be\u0987\u099a\u09a4 \u09b9\u09cb\u09f1\u09be\u099f\u099b\u098f\u09aa \u0987\u09a8\u09b7\u09cd\u099f\u09b2 \u09b9\u09cb\u09f1\u09be \u09a8\u09be\u0987\u0964',t37:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b8\u09be\u09ae\u0997\u09cd\u09f0\u09c0 \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t38:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09f0\u09ae\u09cd\u09ad\u09a3\u09bf\u09f0 \u09a4\u09be\u09f0\u09bf\u0996 \u0986\u09f0\u09c1 \u09b6\u09c7\u09b7\u09f0 \u09a4\u09be\u09f0\u09bf\u0996 \u09a8\u09bf\u09f0\u09cd\u09ac\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995',t39:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09ab\u09cb\u09a8 \u09a8\u0982 10 \u09f0 \u09ad\u09c7\u09f0\u09bf\u09ab\u09be\u0987\u09a1 \u0995\u09f0\u0995\u0964',t40:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0995\u09be\u09f0\u09a3 \u09a8\u09bf\u09f0\u09cd\u09ac\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t41:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09aa\u09cd\u09f0\u09a5\u09ae\u09c7 \u09a0\u09bf\u0995\u09be\u09a6\u09be\u09f0 \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995\u0964',t42:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09a7\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1\u09f0 \u099b\u09ac\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09f0\u0995',t43:'\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0986\u09a7\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09a6\u09bf\u09ac',t44:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0986\u09a7\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1\u09f0 \u09ac\u09c8\u09a7 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09a6\u09bf\u09af\u09bc\u0995',t45:'\u09a0\u09bf\u0995\u09be\u09a6\u09be\u09f0\u09f0 \u09aa\u09a4\u09cd\u09a8\u09c0\u09f0 \u09a8\u09be\u09ae \u09b2\u09bf\u0996\u0995\u0964',t46:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09a0\u09bf\u0995\u09be\u09a6\u09be\u09f0\u09f0 \u09aa\u09a4\u09cd\u09a8\u09c0 dob \u09b2\u09bf\u0996\u0995\u0964',t47:'\u0987\u09ae\u09c7\u0987\u09b2\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t48:'\u09ac\u09c8\u09a7 \u0987\u09ae\u09c7\u0987\u09b2\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t49:'\u09ad\u09cb\u099f\u09be\u09f0\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t50:'\u09ad\u09cb\u099f\u09be\u09f0\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 10 \u0985\u0982\u0995 \u09b9\u09ac \u09b2\u09be\u0997\u09c7\u0964',t51:'\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09ad\u09cb\u099f\u09be\u09f0\u09f0 \u0995\u09be\u09f0\u09cd\u09a1 \u09ac\u09cd\u09f0\u09be\u0989\u099c \u0995\u09f0\u0995\u0964',t52:'\u0986\u09a7\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 \u099a\u09c7\u0995 \u0995\u09f0\u0995\u0964',t53:'\u09ad\u09cb\u099f\u09be\u09f0 \u0995\u09be\u09f0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995\u0964',t54:"\u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09af\u09bf\u0995\u09cb\u09a8\u09cb I'd \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09f0\u0995\u0964"};case'Bengali':return{error:'\u09a4\u09cd\u09b0\u09c1\u099f\u09bf',success:'\u09b8\u09ab\u09b2\u09a4\u09be',exit_app:'\u0985\u09cd\u09af\u09be\u09aa \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a5\u09be\u09a8 \u0995\u09b0\u09c1\u09a8',t1:'\u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cd\u09af\u09be\u09ae\u09c7\u09b0\u09be \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09af\u09bc',t2:'\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09c1\u099b\u09c1\u09a8',t3:'\u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be\u09b0 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4?',t4:'\u0985\u099c\u09be\u09a8\u09be \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0998\u099f\u09c7\u099b\u09c7.',t5:'\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a5\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8?',t6:'\u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09b2\u09bf\u0996\u09c1\u09a8.',t7:'\u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7',t8:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 Google Play Store \u09a5\u09c7\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09ac\u09bf\u09b2\u09cd\u09a1\u099f\u09bf \u0987\u09a8\u09b8\u09cd\u099f\u09b2 \u0995\u09b0\u09c1\u09a8',t9:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 App Store \u09a5\u09c7\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09ac\u09bf\u09b2\u09cd\u09a1\u099f\u09bf \u0987\u09a8\u09b8\u09cd\u099f\u09b2 \u0995\u09b0\u09c1\u09a8',t10:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0993\u099f\u09bf\u09aa\u09bf \u09b2\u09bf\u0996\u09c1\u09a8\u0964',t11:'\u0993\u099f\u09bf\u09aa\u09bf 4 \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4\u0964',t12:'\u09a8\u09be\u09ae \u0986\u09ac\u09b6\u09cd\u09af\u0995.',t13:'\u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t14:'\u0989\u09aa\u09be\u09a6\u09be\u09a8 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8.',t15:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b6\u09be\u0996\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',t16:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a1\u09bf\u09b2\u09be\u09b0/RSSD \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',t17:'\u09ac\u09bf\u09a1\u09bf\u0987 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8.',t18:'\u09a0\u09bf\u0995\u09be\u09a8\u09be 1 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t19:'\u09b6\u09b9\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t20:'\u099c\u09c7\u09b2\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t21:'\u09b0\u09be\u099c\u09cd\u09af \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t22:'\u09a6\u09c7\u09b6 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t23:'\u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t24:'\u099c\u09a8\u09cd\u09ae \u09a4\u09be\u09b0\u09bf\u0996 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t25:'\u0986\u09a7\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t26:'\u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf 12 \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4\u0964',t27:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09ac\u09cd\u09b0\u09be\u0989\u099c \u0995\u09b0\u09c1\u09a8\u0964',t28:'\u0995\u09b0\u09cd\u09ae\u099a\u09be\u09b0\u09c0 \u0995\u09cb\u09a1 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t29:'\u09b6\u09be\u0996\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8',t30:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a1\u09bf\u09b2\u09be\u09b0/\u0986\u09b0\u098f\u09b8\u098f\u09b8\u09a1\u09bf/\u09b8\u09be\u09ac-\u09a1\u09bf\u09b2\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',t31:'\u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8.',t32:'\u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8 \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7.',t33:'\u09ac\u09c8\u09a7 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8.',t34:'\u09a4\u09be\u09b0\u09bf\u0996 \u09b8\u09ae\u09af\u09bc \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8.',t35:'\u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09b2\u09bf\u0996\u09c1\u09a8.',t36:'\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 WhatsApp \u0987\u09a8\u09b8\u09cd\u099f\u09b2 \u0995\u09b0\u09be \u09a8\u09c7\u0987\u0964',t37:'\u09af\u09c7 \u0995\u09cb\u09a8 \u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8.',t38:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 \u098f\u09ac\u0982 \u09b6\u09c7\u09b7 \u09a4\u09be\u09b0\u09bf\u0996 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8',t39:'\u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8.',t40:'\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0995\u09be\u09b0\u09a3 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8.',t41:'\u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0995\u09a8\u09cd\u099f\u09cd\u09b0\u09be\u0995\u09cd\u099f\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',t42:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u099b\u09ac\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\u0964',t43:'\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09b2\u09bf\u0996\u09c1\u09a8\u0964',t44:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09c8\u09a7 \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09b2\u09bf\u0996\u09c1\u09a8\u0964',t45:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u0982\u09af\u09cb\u0997\u0995\u09be\u09b0\u09c0\u09b0 \u09b8\u09cd\u09a4\u09cd\u09b0\u09c0/\u09b8\u09cd\u09ac\u09be\u09ae\u09c0\u09b0 \u09a8\u09be\u09ae \u09b2\u09bf\u0996\u09c1\u09a8\u0964',t46:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u0982\u09af\u09cb\u0997\u0995\u09be\u09b0\u09c0\u09b0 \u09b8\u09cd\u09a4\u09cd\u09b0\u09c0/\u09b8\u09cd\u09ac\u09be\u09ae\u09c0\u09b0 dob \u09b2\u09bf\u0996\u09c1\u09a8\u0964',t47:'\u0987\u09ae\u09c7\u09b2 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t48:'\u09ac\u09c8\u09a7 \u0987\u09ae\u09c7\u09b2 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t49:'\u09ad\u09cb\u099f\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964',t50:'\u09ad\u09cb\u099f\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf 10 \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4\u0964',t51:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ad\u09cb\u099f\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09ac\u09cd\u09b0\u09be\u0989\u099c \u0995\u09b0\u09c1\u09a8\u0964',t52:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964',t53:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ad\u09cb\u099f\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964',t54:'\u0986\u09ae\u09be\u09b0 \u09af\u09c7\u0995\u09cb\u09a8\u09cb\u099f\u09be \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\u0964'};default:return{er